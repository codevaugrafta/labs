{
  "name": "pomodoro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ci": "CI=true npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:install": "npx playwright install chromium",
    "verify:static": "npm run lint && npm test && npm run build",
    "verify:e2e": "bash scripts/run-e2e-with-server.sh",
    "verify": "npm run verify:static && SKIP_E2E_BUILD=1 npm run verify:e2e"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10",
    "@playwright/test": "^1.59.1",
    "eslint-config-next": "16.2.2",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.3"
  }
}
